# Credenciales Google Ads API
# Pega aquí los valores reales en .env (NO commitear .env)

# 1. Developer token (solicitado desde tu cuenta MCC)
GOOGLE_ADS_DEVELOPER_TOKEN=

# 2. OAuth client (Google Cloud Console → APIs & Services → Credentials,
#    tipo Desktop)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# 3. Refresh token (lo genera scripts/01_generate_refresh_token.py)
GOOGLE_ADS_REFRESH_TOKEN=

# 4. Customer IDs (10 dígitos sin guiones)
# - LOGIN_CUSTOMER_ID: la cuenta MCC desde donde autenticas.
# - CUSTOMER_ID:       la cuenta cliente contra la que operas.
# Confundirlos da "authentication failed".
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=

GOOGLE_ADS_USE_PROTO_PLUS=True


# === Opcional — GA4 Data API ===
# Sólo si vas a usar los recipes de docs/GA4_GUIDE.md
# Pasos: crea un service account en GCP, descarga el JSON, da rol "Visor"
# al email del service account en GA4 Admin → Acceso a la propiedad.
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=


# === Opcional — GTM API ===
# Sólo si vas a usar los recipes de docs/GTM_GUIDE.md
GTM_ACCOUNT_ID=
GTM_CONTAINER_ID=
